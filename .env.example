# ============================================================
# APPLICATION
# ============================================================

NODE_ENV=development

APP_NAME=estate-pro-api

APP_VERSION=0.0.1

APP_HOST=0.0.0.0

APP_PORT=3000

# ============================================================
# API
# ============================================================

API_PREFIX=api

API_VERSION=v1

SWAGGER_ENABLED=true

# ============================================================
# DATABASE - DATABASE_URL IS THE CANONICAL DATABASE TARGET
# ============================================================

DATABASE_URL=mysql://<dev-user>:<dev-password>@127.0.0.1:3306/estate_pro

DATABASE_POOL_CONNECTION_LIMIT=10

DATABASE_CONNECT_TIMEOUT_MS=5000

DATABASE_ACQUIRE_TIMEOUT_MS=10000

DATABASE_POOL_IDLE_TIMEOUT_SEC=300

# ============================================================
# SEEDING (development/test only)
# ============================================================

SEED_ADMIN_PASSWORD=<development-seed-admin-password>

SEED_DEVELOPMENT_USER_PASSWORD=<development-seed-user-password>

# ============================================================
# AUTHENTICATION
# ============================================================

JWT_SECRET=<development-jwt-secret-min-32-chars>

JWT_EXPIRES_IN=15m

AUTH_REFRESH_TOKEN_EXPIRES_IN=30d

AUTH_LOGIN_RATE_LIMIT=5

AUTH_LOGIN_RATE_LIMIT_TTL_MS=60000

AUTH_REFRESH_RATE_LIMIT=10

AUTH_REFRESH_RATE_LIMIT_TTL_MS=60000

JWT_ISSUER=estate-pro-api

JWT_AUDIENCE=estate-pro-client

JWT_ALGORITHM=HS256

AUTH_LOCKOUT_THRESHOLD=5

AUTH_LOCKOUT_WINDOW_MS=900000

AUTH_LOCKOUT_DURATION_MS=900000

AUTH_ARGON2_MEMORY_COST=19456

AUTH_ARGON2_TIME_COST=2

AUTH_ARGON2_PARALLELISM=1

AUTH_ARGON2_HASH_LENGTH=32

AUTH_PASSWORD_RESET_TTL_MINUTES=15

AUTH_PASSWORD_RESET_DELIVERY_URL=http://localhost:3000/reset-password

TWO_FACTOR_ENCRYPTION_KEY=<development-2fa-key-min-32-chars>

TWO_FACTOR_CHALLENGE_TTL_MS=300000

TWO_FACTOR_CHALLENGE_MAX_ATTEMPTS=5

TWO_FACTOR_OTP_LOCKOUT_THRESHOLD=5

TWO_FACTOR_OTP_LOCKOUT_DURATION_MS=900000

TWO_FACTOR_RECOVERY_CODE_COUNT=10

# ============================================================
# SECURITY
# ============================================================

SECURITY_CORS_ORIGINS=http://localhost:3000

SECURITY_TRUST_PROXY=loopback

SECURITY_RATE_LIMIT_TTL=60000

SECURITY_RATE_LIMIT_MAX=100

SECURITY_BODY_LIMIT=1mb

SECURITY_COMPRESSION_THRESHOLD=1kb

SECURITY_GRPC_MAX_MESSAGE_BYTES=1048576

SECURITY_CSP_ENABLED=true

SECURITY_HSTS_ENABLED=true

# ============================================================
# LOGGING
# ============================================================

LOG_ENABLED=true

LOG_LEVEL=info

# ============================================================
# OPENTELEMETRY
# ============================================================

OTEL_SERVICE_NAME=estate-pro-api

OTEL_TRACING_ENABLED=true

OTEL_TRACES_EXPORTER=none

OTEL_TRACES_SAMPLER=parentbased_traceidratio

OTEL_TRACES_SAMPLER_ARG=0.1

OTEL_METRICS_ENABLED=false

OTEL_METRICS_EXPORTER=none

OTEL_METRIC_EXPORT_INTERVAL=60000