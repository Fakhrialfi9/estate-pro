# --------------------------------
# APPLICATION
# --------------------------------

NODE_ENV=development
APP_NAME=estate-pro-api
APP_VERSION=0.0.1
APP_HOST=0.0.0.0
APP_PORT=3000

# --------------------------------
# API
# --------------------------------

API_PREFIX=api
API_VERSION=v1

# --------------------------------
# DATABASE
# --------------------------------

DATABASE_HOST=<development-db-host>
DATABASE_PORT=3306
DATABASE_NAME=estate_pro
DATABASE_USER=<development-db-user>
DATABASE_PASSWORD=<development-db-password>
DATABASE_URL="mysql://<development-db-user>:<development-db-password>@<development-db-host>:3306/estate_pro"
DATABASE_POOL_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_SEC=300

# --------------------------------
# AUTHENTICATION
# --------------------------------

# JWT_SECRET must be supplied through a local secret store or environment manager.
JWT_EXPIRES_IN=15m
JWT_ISSUER=estate-pro-api
JWT_AUDIENCE=estate-pro-client
JWT_ALGORITHM=HS256
TWO_FACTOR_ENCRYPTION_KEY=<development-2fa-key-min-32-chars>

# --------------------------------
# SECURITY
# --------------------------------

SECURITY_CORS_ORIGINS=http://localhost:3000
SECURITY_RATE_LIMIT_TTL=60000
SECURITY_RATE_LIMIT_MAX=100
SECURITY_BODY_LIMIT=1mb
SECURITY_COMPRESSION_THRESHOLD=1kb
SECURITY_GRPC_MAX_MESSAGE_BYTES=1048576
SECURITY_TRUST_PROXY=<trusted-proxy-if-required>

# --------------------------------
# LOGGING
# --------------------------------

LOG_ENABLED=true
LOG_LEVEL=info

# --------------------------------
# OPENTELEMETRY
# --------------------------------

OTEL_SERVICE_NAME=estate-pro-api
OTEL_TRACING_ENABLED=true
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRICS_ENABLED=true
OTEL_METRIC_EXPORT_INTERVAL=60000
