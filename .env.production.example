# --------------------------------
# APPLICATION
# --------------------------------

NODE_ENV=production
APP_NAME=estate-pro-api
APP_VERSION=0.0.1
APP_HOST=0.0.0.0
APP_PORT=3000

# --------------------------------
# API
# --------------------------------

API_PREFIX=api
API_VERSION=v1

# --------------------------------
# DATABASE
# --------------------------------

DATABASE_HOST=<production-db-host>
DATABASE_PORT=3306
DATABASE_NAME=estate_pro
DATABASE_USER=<production-db-user>
DATABASE_PASSWORD=<production-db-password>
DATABASE_URL="mysql://<production-db-user>:<production-db-password>@<production-db-host>:3306/estate_pro"
DATABASE_POOL_CONNECTION_LIMIT=10
DATABASE_CONNECT_TIMEOUT_MS=5000
DATABASE_ACQUIRE_TIMEOUT_MS=10000
DATABASE_POOL_IDLE_TIMEOUT_SEC=300

# --------------------------------
# AUTHENTICATION
# --------------------------------

# JWT_SECRET must be supplied through a production secret manager.
JWT_EXPIRES_IN=15m
JWT_ISSUER=estate-pro-api
JWT_AUDIENCE=estate-pro-client
JWT_ALGORITHM=HS256
AUTH_ARGON2_MEMORY_COST=19456
AUTH_ARGON2_TIME_COST=2
AUTH_ARGON2_PARALLELISM=1
# Supply a real key only when 2FA encryption is enabled.
# TWO_FACTOR_ENCRYPTION_KEY=<production-2fa-key-min-32-chars>

# --------------------------------
# SECURITY
# --------------------------------

# Replace this with the actual allowed production origins.
SECURITY_CORS_ORIGINS=<allowed-production-origins>
SECURITY_RATE_LIMIT_TTL=60000
SECURITY_RATE_LIMIT_MAX=100
SECURITY_BODY_LIMIT=1mb
SECURITY_COMPRESSION_THRESHOLD=1kb
SECURITY_GRPC_MAX_MESSAGE_BYTES=1048576
# Set only after verifying the actual trusted proxy topology.
# SECURITY_TRUST_PROXY=<trusted-proxy-ip-or-subnet>
SECURITY_CSP_ENABLED=true
# Render terminates TLS at the edge; keep HSTS enabled only for a public HTTPS origin.
SECURITY_HSTS_ENABLED=true

# --------------------------------
# LOGGING
# --------------------------------

LOG_ENABLED=true
LOG_LEVEL=info

# --------------------------------
# OPENTELEMETRY
# --------------------------------

OTEL_SERVICE_NAME=estate-pro-api
OTEL_TRACING_ENABLED=true
OTEL_TRACES_SAMPLER_ARG=0.1
OTEL_METRICS_ENABLED=true
OTEL_METRIC_EXPORT_INTERVAL=60000
