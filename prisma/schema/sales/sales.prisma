model SalesOpportunity {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  uuid String @unique @default(uuid()) @db.Char(36)
  leadUuid String @unique @db.Char(36)
  contactUuid String @db.Char(36)
  ownerUserUuid String? @db.Char(36)
  status String @default("OPEN") @db.VarChar(30)
  idempotencyKey String @unique @db.VarChar(120)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([contactUuid])
  @@index([ownerUserUuid, status])
  @@map("sales_opportunities")
}
