model AuthenticationRefreshTokenFamily {
  id          String                    @id @default(uuid()) @db.Char(36)
  userId      BigInt                    @map("user_id") @db.UnsignedBigInt
  sessionId   BigInt                    @map("session_id") @db.UnsignedBigInt
  revokedAt   DateTime?                 @map("revoked_at")
  revokeReason String?                  @map("revoke_reason") @db.VarChar(40)
  createdAt   DateTime                  @default(now()) @map("created_at")
  updatedAt   DateTime                  @updatedAt @map("updated_at")
  user        AuthenticationUser        @relation(fields: [userId], references: [id])
  session     AuthenticationUserSession  @relation(fields: [sessionId], references: [id])
  tokens      AuthenticationRefreshToken[]

  @@index([userId, revokedAt])
  @@index([sessionId, revokedAt])
  @@index([revokedAt])
  @@map("authentication_refresh_token_families")
}

model AuthenticationRefreshToken {
  id          BigInt                        @id @default(autoincrement()) @db.UnsignedBigInt
  familyId    String                        @map("family_id") @db.Char(36)
  tokenHash   String                        @unique @map("token_hash") @db.Char(64)
  issuedAt    DateTime                      @map("issued_at")
  expiresAt   DateTime                      @map("expires_at")
  consumedAt  DateTime?                     @map("consumed_at")
  revokedAt   DateTime?                     @map("revoked_at")
  revokeReason String?                      @map("revoke_reason") @db.VarChar(40)
  createdAt   DateTime                      @default(now()) @map("created_at")
  family      AuthenticationRefreshTokenFamily @relation(fields: [familyId], references: [id])

  @@index([familyId])
  @@index([expiresAt])
  @@index([consumedAt])
  @@index([revokedAt])
  @@map("authentication_refresh_tokens")
}
