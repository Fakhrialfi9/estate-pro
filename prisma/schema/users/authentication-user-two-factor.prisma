model AuthenticationUserTwoFactor {
    /**
     * Identity
     */
    id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

    /**
     * User Reference
     */
    userId BigInt @unique @map("user_id") @db.UnsignedBigInt

    /**
     * Two Factor Configuration
     */
    method String @default("totp") @db.VarChar(30)

    secretEncrypted String @map("secret_encrypted") @db.Text

    /**
     * Activity
     */
    enabledAt DateTime? @map("enabled_at")

    lastUsedAt DateTime? @map("last_used_at")

    /**
     * Timestamps
     */
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    /**
     * Relations
     */
    user AuthenticationUser @relation(fields: [userId], references: [id])

    @@map("authentication_user_two_factors")
}
