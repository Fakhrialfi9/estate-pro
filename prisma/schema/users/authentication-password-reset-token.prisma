model AuthenticationPasswordResetToken {
    id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

    userId BigInt @map("user_id") @db.UnsignedBigInt

    tokenDigest String @unique @map("token_digest") @db.Char(64)

    expiresAt DateTime @map("expires_at")
    usedAt DateTime? @map("used_at")
    createdAt DateTime @default(now()) @map("created_at")

    user AuthenticationUser @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([expiresAt])
    @@index([usedAt])
    @@index([userId, expiresAt, usedAt], map: "authentication_password_reset_tokens_user_exp_used_idx")
    @@map("authentication_password_reset_tokens")
}
