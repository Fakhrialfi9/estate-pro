model AuthenticationUserCredential {
    /**
     * Identity
     */
    id BigInt @id @default(autoincrement()) @db.UnsignedBigInt

    /**
     * User Reference
     */
    userId BigInt @unique @map("user_id") @db.UnsignedBigInt

    /**
     * Password
     */
    passwordHash String @map("password_hash") @db.VarChar(255)

    passwordChangedAt DateTime? @map("password_changed_at")

    passwordExpiresAt DateTime? @map("password_expires_at")

    /**
     * Timestamps
     */
    createdAt DateTime @default(now()) @map("created_at")
    updatedAt DateTime @updatedAt @map("updated_at")

    /**
     * Relations
     */
    user AuthenticationUser @relation(fields: [userId], references: [id])

    @@map("authentication_user_credentials")
}
