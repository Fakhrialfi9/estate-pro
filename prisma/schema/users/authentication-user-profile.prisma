model AuthenticationUserProfile {
  id                 BigInt             @id @default(autoincrement()) @db.UnsignedBigInt
  userId             BigInt             @unique @map("user_id") @db.UnsignedBigInt
  firstName          String?            @map("first_name") @db.VarChar(100)
  lastName           String?            @map("last_name") @db.VarChar(100)
  imageUrl           String?            @map("image_url") @db.VarChar(500)
  avatarThumbnailUrl String?            @map("avatar_thumbnail_url") @db.VarChar(500)
  timezone           String             @default("Asia/Jakarta") @db.VarChar(100)
  locale             String             @default("id") @db.VarChar(10)
  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @updatedAt @map("updated_at")
  user               AuthenticationUser @relation(fields: [userId], references: [id])

  @@map("authentication_user_profiles")
}
