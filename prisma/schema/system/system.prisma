model SystemSetting {
  id           BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid         String   @unique @db.Char(36)
  key          String   @db.VarChar(128)
  scope        String   @db.VarChar(32)
  scopeKey     String   @default("global") @db.VarChar(128)
  valueType    String   @db.VarChar(16)
  value        String   @db.VarChar(4000)
  mutable      Boolean  @default(true)
  version      Int      @default(1)
  createdAt    DateTime @default(now()) @db.DateTime(3)
  updatedAt    DateTime @updatedAt @db.DateTime(3)
  @@unique([key, scope, scopeKey])
  @@index([scope, scopeKey])
  @@map("system_settings")
}

model SystemActivity {
  id            BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid          String   @unique @db.Char(36)
  actorUuid     String?  @db.Char(36)
  eventType     String   @db.VarChar(80)
  category      String   @db.VarChar(40)
  resourceType  String?  @db.VarChar(80)
  resourceUuid  String?  @db.Char(36)
  summary       String   @db.VarChar(500)
  metadata      Json
  requestId     String?  @db.VarChar(120)
  createdAt     DateTime @default(now()) @db.DateTime(3)
  @@index([actorUuid, createdAt])
  @@index([resourceType, resourceUuid, createdAt])
  @@index([category, createdAt])
  @@index([createdAt])
  @@map("system_activities")
}

model SystemImportJob {
  id                  BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                String   @unique @db.Char(36)
  actorUuid           String   @map("actor_uuid") @db.Char(36)
  filename            String   @db.VarChar(255)
  format              String   @db.VarChar(8)
  state               String   @db.VarChar(16)
  preview             Boolean  @default(false)
  idempotencyKey      String?  @map("idempotency_key") @db.VarChar(128)
  columnMapping       Json     @map("column_mapping")
  fieldMapping        Json     @map("field_mapping")
  conflictStrategy    String   @default("FAIL") @map("conflict_strategy") @db.VarChar(16)
  transactionStrategy String   @default("ROW") @map("transaction_strategy") @db.VarChar(24)
  totalRows           Int      @default(0) @map("total_rows")
  processedRows       Int      @default(0) @map("processed_rows")
  failedRows          Int      @default(0) @map("failed_rows")
  errors              Json
  sourcePath          String?  @map("source_path") @db.VarChar(500)
  expiresAt           DateTime @map("expires_at")
  createdAt           DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@unique([actorUuid, idempotencyKey])
  @@index([actorUuid, createdAt])
  @@index([state, expiresAt])
  @@map("system_import_jobs")
}

model SystemExportJob {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid              String   @unique @db.Char(36)
  actorUuid         String   @map("actor_uuid") @db.Char(36)
  entity            String   @db.VarChar(40)
  format            String   @db.VarChar(8)
  state             String   @db.VarChar(16)
  filters           Json
  artifactPath      String?  @map("artifact_path") @db.VarChar(500)
  downloadTokenHash String?  @map("download_token_hash") @db.Char(64)
  rows              Int      @default(0)
  estimatedRows     Int?     @map("estimated_rows")
  processedRows     Int      @default(0)
  completedAt       DateTime? @map("completed_at") @db.DateTime(3)
  cancelledAt       DateTime? @map("cancelled_at") @db.DateTime(3)
  cancelRequested   Boolean  @default(false) @map("cancel_requested")
  artifactBytes     BigInt?  @map("artifact_bytes") @db.UnsignedBigInt
  expiresAt         DateTime @map("expires_at")
  errorMessage      String?  @map("error_message") @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  @@index([actorUuid, createdAt])
  @@index([state, expiresAt])
  @@index([downloadTokenHash])
  @@index([cancelRequested, state])
  @@map("system_export_jobs")
}

model SystemWebhookSubscription {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid              String   @unique @db.Char(36)
  endpoint          String   @db.VarChar(2048)
  status            String   @db.VarChar(16)
  events            Json
  filters            Json
  secretCiphertext  String   @map("secret_ciphertext") @db.Text
  secretVersion     Int      @default(1) @map("secret_version")
  secretCreatedAt   DateTime @default(now()) @map("secret_created_at") @db.DateTime(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  deliveries        SystemWebhookDelivery[]
  @@index([status, createdAt])
  @@map("system_webhook_subscriptions")
}

model SystemWebhookDelivery {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid              String   @unique @db.Char(36)
  subscriptionId    BigInt   @map("subscription_id") @db.UnsignedBigInt
  eventId           String   @map("event_id") @db.VarChar(128)
  deliveryKey       String   @map("delivery_key") @db.VarChar(180)
  eventName         String   @db.VarChar(120)
  eventVersion      Int      @default(1) @map("event_version")
  payloadHash       String   @map("payload_hash") @db.Char(64)
  attemptCount      Int      @default(0)
  state             String   @db.VarChar(24)
  httpStatus        Int?
  responseSummary   String?  @db.VarChar(500)
  nextAttemptAt     DateTime? @db.DateTime(3)
  signedAt          DateTime @db.DateTime(3)
  completedAt       DateTime? @db.DateTime(3)
  failureReason     String?  @db.VarChar(500)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  subscription      SystemWebhookSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  @@unique([subscriptionId, deliveryKey], map: "system_webhook_delivery_subscription_delivery_key_unique")
  @@index([subscriptionId, createdAt])
  @@index([state, nextAttemptAt])
  @@index([payloadHash])
  @@map("system_webhook_deliveries")
}

model SystemIntegration {
  id                BigInt   @id @default(autoincrement()) @db.UnsignedBigInt
  uuid              String   @unique @db.Char(36)
  providerKey       String   @map("provider_key") @db.VarChar(80)
  providerVersion   String   @map("provider_version") @db.VarChar(40)
  capabilities      Json
  state             String   @db.VarChar(24)
  metadata          Json
  secretRef         String?  @map("secret_ref") @db.VarChar(255)
  lastTestAt        DateTime? @map("last_test_at") @db.DateTime(3)
  lastSyncAt         DateTime? @map("last_sync_at") @db.DateTime(3)
  errorCode         String?  @db.VarChar(80)
  errorMessage      String?  @db.VarChar(500)
  createdAt         DateTime @default(now()) @db.DateTime(3)
  updatedAt         DateTime @updatedAt @db.DateTime(3)
  @@unique([providerKey, providerVersion])
  @@index([state, updatedAt])
  @@map("system_integrations")
}
