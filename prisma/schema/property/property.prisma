model Property {
  id                    BigInt                    @id @default(autoincrement()) @db.UnsignedBigInt
  uuid                  String                    @unique @default(uuid()) @db.Char(36)
  businessCode          String                    @unique @map("business_code") @db.VarChar(40)
  referenceNumber       String                    @unique @map("reference_number") @db.VarChar(80)
  propertyTypeId        BigInt                    @map("property_type_id") @db.UnsignedBigInt
  propertyCategoryId    BigInt                    @map("property_category_id") @db.UnsignedBigInt
  propertySubcategoryId BigInt?                   @map("property_subcategory_id") @db.UnsignedBigInt
  subdistrictId         BigInt?                   @map("subdistrict_id") @db.UnsignedBigInt
  title                 String                    @db.VarChar(200)
  slug                  String                    @unique @db.VarChar(220)
  shortDescription      String?                   @map("short_description") @db.VarChar(500)
  description           String?                   @db.Text
  status                PropertyStatus            @default(DRAFT)
  availabilityStatus    AvailabilityStatus        @default(AVAILABLE) @map("availability_status")
  availableFrom         DateTime?                 @map("available_from")
  availableTo           DateTime?                 @map("available_to")
  version               Int                       @default(1)
  publishedAt           DateTime?                 @map("published_at")
  verifiedAt             DateTime?                 @map("verified_at")
  createdBy              String?                   @map("created_by") @db.Char(36)
  updatedBy              String?                   @map("updated_by") @db.Char(36)
  verifiedBy             String?                   @map("verified_by") @db.Char(36)
  deletedAt              DateTime?                 @map("deleted_at")
  deletedBy              String?                   @map("deleted_by") @db.Char(36)
  createdAt              DateTime                  @default(now()) @map("created_at")
  updatedAt              DateTime                  @updatedAt @map("updated_at")
  propertyCategory      PropertyCategory          @relation(fields: [propertyCategoryId], references: [id])
  propertySubcategory   PropertySubcategory?      @relation(fields: [propertySubcategoryId], references: [id], onDelete: Restrict)
  propertyType          PropertyType              @relation(fields: [propertyTypeId], references: [id])
  subdistrict           Subdistrict?              @relation(fields: [subdistrictId], references: [id], onDelete: Restrict)
  agentAssignments      PropertyAgentAssignment[]
  agentAssignmentHistory PropertyAgentAssignmentHistory[]
  building              PropertyBuilding?
  certificates          PropertyCertificate[]
  environment           PropertyEnvironment?
  facilities            PropertyFacility[]
  features              PropertyFeatures?
  financial             PropertyFinancial?
  legal                 PropertyLegal?
  listing               PropertyListing?
  location              PropertyLocation?
  media                 PropertyMedia[]
  owner                 PropertyOwner?
  rooms                 PropertyRoom[]
  security              PropertySecurity?
  seo                   PropertySeo?
  specification         PropertySpecification?
  utilities             PropertyUtility?

  @@index([availabilityStatus, availableFrom, availableTo])
  @@index([propertyCategoryId], map: "properties_property_category_id_fkey")
  @@index([propertySubcategoryId], map: "properties_property_subcategory_id_fkey")
  @@index([deletedAt], map: "properties_deleted_idx")
  @@index([status, deletedAt, updatedAt, id], map: "properties_status_deleted_updated_idx")
  @@index([subdistrictId], map: "properties_subdistrict_idx")
  @@index([propertyTypeId, propertyCategoryId, propertySubcategoryId], map: "properties_type_category_subcategory_idx")
  @@map("properties")
}

model PropertyFacility {
  propertyId BigInt   @map("property_id") @db.UnsignedBigInt
  facilityId BigInt   @map("facility_id") @db.UnsignedBigInt
  createdAt  DateTime @default(now()) @map("created_at")
  available  Boolean  @default(true)
  quantity   Int?
  notes      String?  @db.VarChar(500)
  updatedAt  DateTime @updatedAt @map("updated_at")
  facility   Facility @relation(fields: [facilityId], references: [id])
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@id([propertyId, facilityId])
  @@index([facilityId], map: "property_facilities_facility_idx")
  @@index([propertyId, available], map: "property_facilities_property_available_idx")
  @@map("property_facilities")
}

enum PropertyStatus {
  DRAFT
  IN_REVIEW
  ACTIVE
  ARCHIVED
  SOLD
  RENTED
}

enum AvailabilityStatus {
  AVAILABLE
  UNAVAILABLE
}
