enum AreaUnit {
  SQM
}

enum PropertyOrientation {
  NORTH
  NORTHEAST
  EAST
  SOUTHEAST
  SOUTH
  SOUTHWEST
  WEST
  NORTHWEST
  UNKNOWN
}

enum PropertyCondition {
  NEW
  GOOD
  FAIR
  NEEDS_RENOVATION
  RENOVATED
}

enum FurnishedStatus {
  UNFURNISHED
  SEMI_FURNISHED
  FULLY_FURNISHED
}

enum ParkingType {
  NONE
  CARPORT
  GARAGE
  OPEN_PARKING
  STREET_PARKING
  MIXED
}

enum CoordinateAccuracy {
  ROOFTOP
  RANGE_INTERPOLATED
  GEOMETRIC_CENTER
  APPROXIMATE
  UNKNOWN
}

enum MapProvider {
  GOOGLE_MAPS
  MAPBOX
  OPENSTREETMAP
  APPLE_MAPS
  OTHER
}

enum RiskLevel {
  UNKNOWN
  LOW
  MODERATE
  HIGH
  VERY_HIGH
}

enum NaturalLightingLevel {
  EXCELLENT
  GOOD
  MODERATE
  LIMITED
  NONE
}

enum VentilationType {
  NATURAL
  MECHANICAL
  MIXED
  NONE
}

enum RoomType {
  MASTER_BEDROOM
  BEDROOM
  LIVING_ROOM
  FAMILY_ROOM
  DINING_ROOM
  KITCHEN
  BATHROOM
  GUEST_TOILET
  MAID_ROOM
  STUDY
  OFFICE
  PLAYROOM
  STORAGE
  LAUNDRY
  PRAYER_ROOM
  OTHER
}

model PropertySpecification {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  uuid String @unique @default(uuid()) @db.Char(36)
  propertyId BigInt @unique @map("property_id") @db.UnsignedBigInt
  landArea Decimal? @map("land_area") @db.Decimal(18, 2)
  landAreaUnit AreaUnit @default(SQM) @map("land_area_unit")
  buildingArea Decimal? @map("building_area") @db.Decimal(18, 2)
  buildingAreaUnit AreaUnit @default(SQM) @map("building_area_unit")
  floorArea Decimal? @map("floor_area") @db.Decimal(18, 2)
  floorAreaUnit AreaUnit @default(SQM) @map("floor_area_unit")
  bedrooms Int @default(0)
  bathrooms Decimal @default(0) @db.Decimal(8, 2)
  maidRooms Int @default(0) @map("maid_rooms")
  guestToilets Int @default(0) @map("guest_toilets")
  floors Int @default(1)
  parkingType ParkingType @default(NONE) @map("parking_type")
  parkingSpaces Int @default(0) @map("parking_spaces")
  livingRooms Int @default(0) @map("living_rooms")
  familyRooms Int @default(0) @map("family_rooms")
  diningRooms Int @default(0) @map("dining_rooms")
  kitchens Int @default(0)
  yearBuilt Int? @map("year_built")
  yearRenovated Int? @map("year_renovated")
  orientation PropertyOrientation @default(UNKNOWN)
  condition PropertyCondition @default(GOOD)
  furnishedStatus FurnishedStatus @default(UNFURNISHED) @map("furnished_status")
  ceilingHeightM Decimal? @map("ceiling_height_m") @db.Decimal(8, 2)
  frontageM Decimal? @map("frontage_m") @db.Decimal(10, 2)
  roadWidthM Decimal? @map("road_width_m") @db.Decimal(10, 2)
  createdBy String? @map("created_by") @db.Char(36)
  updatedBy String? @map("updated_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([yearBuilt])
  @@index([bedrooms, bathrooms])
  @@map("property_specifications")
}

model PropertyLocation {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  uuid String @unique @default(uuid()) @db.Char(36)
  propertyId BigInt @unique @map("property_id") @db.UnsignedBigInt
  countryId BigInt? @map("country_id") @db.UnsignedBigInt
  provinceId BigInt? @map("province_id") @db.UnsignedBigInt
  cityId BigInt? @map("city_id") @db.UnsignedBigInt
  districtId BigInt? @map("district_id") @db.UnsignedBigInt
  subdistrictId BigInt? @map("subdistrict_id") @db.UnsignedBigInt
  addressLine String? @map("address_line") @db.VarChar(500)
  street String? @db.VarChar(200)
  building String? @db.VarChar(160)
  block String? @db.VarChar(80)
  unit String? @db.VarChar(80)
  neighborhood String? @db.VarChar(200)
  postalCode String? @map("postal_code") @db.VarChar(20)
  latitude Decimal? @db.Decimal(10, 7)
  longitude Decimal? @db.Decimal(10, 7)
  coordinateAccuracy CoordinateAccuracy @default(UNKNOWN) @map("coordinate_accuracy")
  mapProvider MapProvider? @map("map_provider")
  placeId String? @map("place_id") @db.VarChar(255)
  mapUrl String? @map("map_url") @db.VarChar(1000)
  floodRisk RiskLevel @default(UNKNOWN) @map("flood_risk")
  earthquakeRisk RiskLevel @default(UNKNOWN) @map("earthquake_risk")
  trafficRisk RiskLevel @default(UNKNOWN) @map("traffic_risk")
  noiseRisk RiskLevel @default(UNKNOWN) @map("noise_risk")
  airQualityRisk RiskLevel @default(UNKNOWN) @map("air_quality_risk")
  createdBy String? @map("created_by") @db.Char(36)
  updatedBy String? @map("updated_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  country Country? @relation(fields: [countryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  province Province? @relation(fields: [provinceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  city City? @relation(fields: [cityId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  district District? @relation(fields: [districtId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  subdistrict Subdistrict? @relation(fields: [subdistrictId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  @@index([countryId, provinceId, cityId, districtId, subdistrictId])
  @@index([latitude, longitude])
  @@map("property_locations")
}

model PropertyBuilding {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  uuid String @unique @default(uuid()) @db.Char(36)
  propertyId BigInt @unique @map("property_id") @db.UnsignedBigInt
  foundation String? @db.VarChar(150)
  structure String? @db.VarChar(150)
  walls String? @db.VarChar(150)
  roof String? @db.VarChar(150)
  flooring String? @db.VarChar(150)
  doors String? @db.VarChar(150)
  windows String? @db.VarChar(150)
  facade String? @db.VarChar(300)
  garden String? @db.VarChar(300)
  terrace String? @db.VarChar(300)
  balcony String? @db.VarChar(300)
  rooftop String? @db.VarChar(300)
  hasPool Boolean @default(false) @map("has_pool")
  poolLengthM Decimal? @map("pool_length_m") @db.Decimal(8, 2)
  poolWidthM Decimal? @map("pool_width_m") @db.Decimal(8, 2)
  poolDepthM Decimal? @map("pool_depth_m") @db.Decimal(8, 2)
  interiorStyle String? @map("interior_style") @db.VarChar(150)
  interiorDesign String? @map("interior_design") @db.VarChar(500)
  naturalLighting NaturalLightingLevel @default(MODERATE) @map("natural_lighting")
  ventilation VentilationType @default(NATURAL)
  smartHome Boolean @default(false) @map("smart_home")
  soundproofing Boolean @default(false)
  createdBy String? @map("created_by") @db.Char(36)
  updatedBy String? @map("updated_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@map("property_buildings")
}

model PropertyRoom {
  id BigInt @id @default(autoincrement()) @db.UnsignedBigInt
  uuid String @unique @default(uuid()) @db.Char(36)
  propertyId BigInt @map("property_id") @db.UnsignedBigInt
  roomType RoomType @map("room_type")
  name String @db.VarChar(150)
  floor Int
  area Decimal @db.Decimal(18, 2)
  areaUnit AreaUnit @default(SQM) @map("area_unit")
  hasBathroom Boolean @default(false) @map("has_bathroom")
  hasWalkInCloset Boolean @default(false) @map("has_walk_in_closet")
  hasBalcony Boolean @default(false) @map("has_balcony")
  hasAirConditioning Boolean @default(false) @map("has_air_conditioning")
  sortOrder Int @default(0) @map("sort_order")
  createdBy String? @map("created_by") @db.Char(36)
  updatedBy String? @map("updated_by") @db.Char(36)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")
  property Property @relation(fields: [propertyId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  @@index([propertyId, deletedAt, sortOrder])
  @@index([propertyId, roomType, deletedAt])
  @@map("property_rooms")
}
