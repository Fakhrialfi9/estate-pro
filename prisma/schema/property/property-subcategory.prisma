model PropertySubcategory {
  id                 BigInt           @id @default(autoincrement()) @db.UnsignedBigInt
  uuid               String           @unique @default(uuid()) @db.Char(36)
  propertyCategoryId BigInt           @map("property_category_id") @db.UnsignedBigInt
  code               String           @db.VarChar(50)
  name               String           @db.VarChar(150)
  slug               String           @db.VarChar(100)
  description        String?          @db.Text
  isActive           Boolean          @default(true) @map("is_active")
  sortOrder          Int              @default(0) @map("sort_order")
  createdAt          DateTime         @default(now()) @map("created_at")
  updatedAt          DateTime         @updatedAt @map("updated_at")
  deletedAt          DateTime?        @map("deleted_at")
  properties         Property[]
  propertyCategory   PropertyCategory @relation(fields: [propertyCategoryId], references: [id])

  @@unique([propertyCategoryId, code], map: "property_subcategories_category_code_key")
  @@unique([propertyCategoryId, slug], map: "property_subcategories_category_slug_key")
  @@index([isActive], map: "property_subcategories_active_idx")
  @@index([propertyCategoryId], map: "property_subcategories_category_idx")
  @@index([sortOrder], map: "property_subcategories_sort_idx")
  @@map("property_subcategories")
}
