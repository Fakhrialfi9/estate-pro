model PropertySubcategory {
    id                 BigInt          @id @default(autoincrement()) @db.UnsignedBigInt
    uuid               String          @unique @default(uuid()) @db.Char(36)
    propertyCategoryId BigInt          @map("property_category_id") @db.UnsignedBigInt
    code               String          @db.VarChar(50)
    name               String          @db.VarChar(150)
    slug               String          @db.VarChar(100)
    description        String?         @db.Text
    isActive           Boolean         @default(true) @map("is_active")
    sortOrder          Int             @default(0) @map("sort_order")
    createdAt          DateTime        @default(now()) @map("created_at")
    updatedAt          DateTime        @updatedAt @map("updated_at")
    deletedAt          DateTime?       @map("deleted_at")
    propertyCategory   PropertyCategory @relation(fields: [propertyCategoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)
    properties         Property[]

    @@unique([propertyCategoryId, code])
    @@unique([propertyCategoryId, slug])
    @@index([propertyCategoryId])
    @@index([isActive])
    @@index([sortOrder])
    @@map("property_subcategories")
}
